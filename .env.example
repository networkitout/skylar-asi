# SKYLAR configuration
#
# Docker: copy to .env; every variable here reaches the backend container.
# Manual install: export these in the shell that runs the backend instead.
# Blank values mean "use the default".

# ==================== Required ====================

# Signs sessions and derives the key that encrypts Cloudflare API tokens.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep it stable: changing it makes stored tokens unreadable.
SECRET_KEY=

# Salt for the token-encryption key. Generate: python3 -c "import secrets; print(secrets.token_hex(16))"
# Leaving it empty falls back to a built-in salt (and warns). Setting it on an
# existing install is safe: stored tokens are re-encrypted on the next start.
ENCRYPTION_SALT=

# PostgreSQL password for the Docker database. Hex avoids URL-reserved characters.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=

# ==================== Database ====================

# Docker supplies DATABASE_URL automatically (PostgreSQL on the compose network).
# Manual installs must set it; SQLite is the simplest:
# DATABASE_URL=sqlite:///./data/skylar.db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/skylar

# Database name/user used by compose. They predate the SKYLAR rename and are
# kept so existing installs keep their data; override only on a fresh install.
# POSTGRES_USER=cloudflare
# POSTGRES_DB=cloudflare_reporter

# Keep an existing database volume after renaming the checkout directory
# (the compose project name defaults to the directory name).
# COMPOSE_PROJECT_NAME=skylar-asi

# ==================== Web ====================

# Host port for the UI (Docker).
# SKYLAR_PORT=3000

# Cloudflare Tunnel token; start with: docker compose --profile tunnel up -d
# CF_TUNNEL_TOKEN=

# CORS origins, comma-separated, no wildcards. Only needed when the frontend
# is served from a different origin than the API; the Docker and dev setups
# are same-origin via the /api proxy.
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Expose /docs, /redoc and /openapi.json. Off in production.
# ENABLE_DOCS=false

# ==================== Schedulers ====================

# Automatic sync of every active config, in minutes; 0 disables.
# SYNC_INTERVAL_MINUTES=60

# Automatic reachability checks, in minutes; 0 (default) disables because
# probing every hostname is more intrusive than an API sync.
# REACHABILITY_INTERVAL_MINUTES=0

# Prune reachability history older than this many days; 0 keeps everything.
# REACHABILITY_RETENTION_DAYS=90

# Hours of hourly traffic buckets re-fetched on each sync. 72 fits the Free
# plan's 3-day GraphQL retention; raise it for zones on paid plans.
# ANALYTICS_LOOKBACK_HOURS=72

# ==================== Exposure analysis ====================

# Directory of technology signature YAML files (default: backend/signatures).
# EXPOSURE_SIGNATURES_DIR=

# Active verify (opt-in per run) sends GET-only probes from this server.
# Identify them so site owners can recognise the traffic, and pace them.
# EXPOSURE_VERIFY_USER_AGENT=SKYLAR-ExposureCheck/1.0 (+https://github.com/networkitout/skylar-asi)
# EXPOSURE_VERIFY_CONCURRENCY=4
# EXPOSURE_VERIFY_DELAY_SECONDS=0.25
# EXPOSURE_VERIFY_MAX_HOSTS=300

# ==================== Frontend build ====================

# API base URL baked in at build time. Leave unset: the app uses the relative
# /api path, which the Vite dev server and the nginx image both proxy.
# VITE_API_URL=

# See QUICKSTART.md to get running, docs/DEPLOYMENT.md for production,
# and docs/SECURITY.md for what is enforced.
